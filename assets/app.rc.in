// Template: build.rs fills in the version (from Cargo.toml) and file paths.
#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VER_COMMAS@
PRODUCTVERSION @VER_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Music Notch"
      VALUE "CompanyName", "USRNME"
      VALUE "ProductName", "Music Notch"
      VALUE "FileVersion", "@VER@"
      VALUE "ProductVersion", "@VER@"
      VALUE "OriginalFilename", "music-notch.exe"
      VALUE "LegalCopyright", "Copyright (c) 2026 USRNME. MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
